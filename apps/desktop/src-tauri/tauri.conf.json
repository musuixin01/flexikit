{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "FlexiKit",
  "version": "0.1.0",
  "identifier": "com.flexikit.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlexiKit",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "pet",
        "title": "FlexiKit Pet",
        "url": "index.html#/pet",
        "width": 128,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "canvas",
        "title": "FlexiKit Desktop Canvas",
        "url": "index.html#/canvas",
        "width": 1080,
        "height": 720,
        "minWidth": 520,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
